<Window x:Class="BanHangChuNgoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BanHangChuNgoc.ViewModels"
        mc:Ignorable="d"
        Title="Phần Mềm Quản Lý Bán Quần Áo Theo Bao - Chú Ngọc" 
        Height="870" Width="1400" 
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12,8,12,12">
        <!-- MAIN TABS -->
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: BÁN HÀNG & MỞ BAO -->
            <TabItem Header="🛒 Bán Hàng &amp; Quản Lý Bao">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/> <!-- Cột 1: Quản lý bao -->
                        <ColumnDefinition Width="*"/>   <!-- Cột 2: Bán lẻ từng áo & Đo hòa vốn / Lãi -->
                        <ColumnDefinition Width="340"/> <!-- Cột 3: Chốt bao thừa -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= CỘT 1: QUẢN LÝ BAO HÀNG ================= -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Form thêm bao -->
                            <RowDefinition Height="*"/>    <!-- Danh sách bao -->
                        </Grid.RowDefinitions>

                        <!-- Form nhập bao mới -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="➕ NHẬP BAO HÀNG MỚI" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Tên bao hàng:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewTenBao, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Text="Tiền vốn (k):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewTienNhapText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Text="Ghi chú:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewGhiChu, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <Button Style="{StaticResource ModernButton}" 
                                        Command="{Binding ThemBaoHangCommand}"
                                        Content="LƯU BAO HÀNG MỚI" 
                                        Background="#2563EB" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách các bao hàng -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="📋 DANH SÁCH BAO HÀNG" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding DanhSachBaoHang}" 
                                         SelectedItem="{Binding SelectedBaoHang, Mode=TwoWay}"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <DockPanel Grid.Row="0">
                                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDangBan}" Value="False">
                                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDangBan}" Value="False">
                                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding TenBao}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="Vốn: " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding TienNhap, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="12" Foreground="#DC2626"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="2" Text="{Binding NgayNhapFormatted}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= CỘT 2: BÁN LẺ ÁO TỪNG CÁI & ĐO HÒA VỐN / LÃI ================= -->
                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Đồng hồ đo hòa vốn & Lãi hơn vốn -->
                            <RowDefinition Height="Auto"/> <!-- Thao tác bán nhanh -->
                            <RowDefinition Height="*"/>    <!-- Danh sách áo đã bán -->
                        </Grid.RowDefinitions>

                        <!-- ĐỒNG HỒ ĐO ĐIỂM HÒA VỐN & CHỈ SỐ LÃI HƠN VỐN -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header bao -->
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="Tiền vốn:" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding SelectedBaoHang.TienNhap, Converter={StaticResource CurrencyConverter}}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ĐANG BÁN BAO:" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding SelectedBaoHang.TenBao, FallbackValue='(Chưa chọn bao hàng)'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SelectedBaoHang.NgayNhapFormatted, StringFormat='Ngày nhập: {0}'}" 
                                                   FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- KHỐI ĐỒNG HỒ ĐO ĐIỂM HÒA VỐN & LÃI HƠN VỐN -->
                                <Border CornerRadius="8" Padding="14" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Hàng tiêu đề hòa vốn -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="🎯 TIẾN ĐỘ HÒA VỐN" FontWeight="Bold" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <TextBlock Text="{Binding CurrentHoaVonPhanTram, StringFormat='{}{0}% VỐN'}" 
                                                       FontWeight="Bold" FontSize="15" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Thanh ProgressBar tiến độ thu hồi vốn -->
                                        <ProgressBar Value="{Binding CurrentHoaVonProgressBarValue}" 
                                                     Maximum="100" Height="14" Margin="0,0,0,8">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <!-- Dòng thông điệp trạng thái -->
                                        <TextBlock Text="{Binding CurrentThongBaoTrangThaiHoaVon}" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- DÒNG LÃI HƠN BAO NHIÊU HOẶC THIẾU BAO NHIÊU -->
                                        <Border CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <TextBlock Text="{Binding CurrentChiTietLaiLo}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="True">
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Đã bán bao nhiêu cái áo -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Đã bán: " FontSize="12" Foreground="#475569"/>
                                                    <TextBlock Text="{Binding CurrentTongAoBanLe, StringFormat='{}{0} cái'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock Text=" • Thu: " FontSize="12" Foreground="#475569" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding CurrentTongTienBanLe, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="13" Foreground="#059669"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Form bán lẻ nhanh -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⚡ BÁN LẺ ÁO" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,10,0"/>

                                <!-- Nhập tiền & Số lượng -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Đơn giá (k):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ModernTextBox}" 
                                                 FontSize="18" FontWeight="Bold" Foreground="#2563EB"
                                                 Text="{Binding QuickDonGiaText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ThemBanLeCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Số lượng:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ModernTextBox}" 
                                                 FontSize="18" FontWeight="Bold"
                                                 Text="{Binding QuickSoLuong, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ThemBanLeCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Thao tác:" FontSize="12" Foreground="Transparent" Margin="0,0,0,4"/>
                                        <Button Style="{StaticResource ModernButton}" 
                                                Height="38"
                                                Command="{Binding ThemBanLeCommand}"
                                                Content="✓ BÁN ÁO NÀY (ENTER)" 
                                                Background="#059669" Foreground="White" FontSize="14"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bảng danh sách các cái áo đã bán ra -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="🧾 DANH SÁCH ÁO ĐÃ BÁN LẺ" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                </DockPanel>

                                <DataGrid Grid.Row="1" 
                                          ItemsSource="{Binding DanhSachBanLe}"
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          BorderThickness="0"
                                          Background="White"
                                          RowHeight="32"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thời gian" Binding="{Binding NgayBanFormatted}" Width="150"/>
                                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat='{}{0} cái'}" Width="80"/>
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaFormatted}" Width="110"/>
                                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTienFormatted}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                                        <DataGridTemplateColumn Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Xóa" FontSize="11" Padding="4,2"
                                                            Command="{Binding DataContext.XoaBanLeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FEE2E2" Foreground="#B91C1C" Style="{StaticResource ModernButton}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= CỘT 3: CHỐT SỔ & BÁN BAO THỪA ================= -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Form chốt bao -->
                            <RowDefinition Height="*"/>    <!-- Bảng tổng kết của bao -->
                        </Grid.RowDefinitions>

                        <!-- Form chốt bao thừa -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📦 CHỐT SỔ BAO THỪA" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,10,0"/>

                                <TextBlock Text="Tiền bán bao thừa (k):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource ModernTextBox}" 
                                         FontSize="16" FontWeight="Bold" Foreground="#D97706"
                                         Text="{Binding ChotTienBanThuaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <Button Style="{StaticResource ModernButton}" 
                                        Command="{Binding ChotBaoHangCommand}"
                                        Content="CHỐT SỔ &amp; KẾT THÚC BAO" 
                                        Background="#D97706" Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <!-- Bảng tổng kết lời/lỗ của bao đang chọn -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💰 KẾT QUẢ CỦA BAO NÀY" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,14,0"/>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="Tiền vốn:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedBaoHang.TienNhap, Converter={StaticResource CurrencyConverter}}" 
                                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="#DC2626"/>
                                    </DockPanel>
                                </Border>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="Thu bán lẻ:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentTongTienBanLe, Converter={StaticResource CurrencyConverter}}" 
                                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669"/>
                                    </DockPanel>
                                </Border>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="Thu bao thừa:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedBaoHang.TienBanThua, Converter={StaticResource CurrencyConverter}}" 
                                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="#D97706"/>
                                    </DockPanel>
                                </Border>

                                <Separator Margin="0,8,0,12"/>

                                <TextBlock Text="LÃI HƠN VỐN / THIẾU VỐN:" FontSize="12" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentTienLaiHonVon, StringFormat='+{0:N0} k'}"/>
                                            <Setter Property="Foreground" Value="#15803D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentDaHoaVon}" Value="False">
                                                    <Setter Property="Text" Value="{Binding CurrentConThieuDeHoaVon, StringFormat='Thiếu {0:N0} k'}"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: BÁO CÁO & DÒNG TIỀN -->
            <TabItem Header="📊 Báo Cáo &amp; Dòng Tiền">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Bộ lọc -->
                        <RowDefinition Height="Auto"/> <!-- 4 Thẻ KPI -->
                        <RowDefinition Height="*"/>    <!-- Bảng dữ liệu thống kê -->
                    </Grid.RowDefinitions>

                    <!-- Bộ lọc theo Tháng và Năm -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tháng:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding DanhSachThang}" SelectedItem="{Binding SelectedThang}" 
                                      Width="120" Height="34" VerticalContentAlignment="Center" Margin="0,0,14,0"/>

                            <TextBlock Text="Năm:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding DanhSachNam}" 
                                      Text="{Binding SelectedNam, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding SelectedNam}" 
                                      IsEditable="True"
                                      Width="110" Height="34" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding LocBaoCaoCommand}"
                                    Content="LỌC BÁO CÁO" Background="#2563EB" Foreground="White" Margin="0,0,8,0"/>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding XoaBoLocBaoCaoCommand}"
                                    Content="XEM TẤT CẢ" Background="#E2E8F0" Foreground="#1E293B"/>
                        </StackPanel>
                    </Border>

                    <!-- 4 THẺ KPI DÒNG TIỀN -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thẻ 1: Tiền vốn -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="TỔNG VỐN BỎ RA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TongBaoCaoTienNhap, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ 2: Thu bán lẻ -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="TỔNG THU BÁN LẺ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TongBaoCaoTienBanLe, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding TongBaoCaoAoBanLe, StringFormat='(Đã bán {0} cái áo)'}" 
                                           FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ 3: Thu bán thừa -->
                        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="TỔNG THU BAO THỪA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TongBaoCaoTienBanThua, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ 4: LỢI NHUẬN RÒNG -->
                        <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="TỔNG LÃI RÒNG HƠN VỐN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TongBaoCaoLoiNhuan, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding TongBaoCaoLoiNhuan, Converter={StaticResource ProfitColorConverter}}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bảng thống kê chi tiết từng bao -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📑 BẢNG CHI TIẾT TỪNG BAO HÀNG" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,10,0"/>

                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding DanhSachThongKe}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      Background="White"
                                      RowHeight="36"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã" Binding="{Binding MaBao}" Width="45"/>
                                    <DataGridTextColumn Header="Tên bao hàng" Binding="{Binding TenBao}" Width="220"/>
                                    <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhapFormatted}" Width="100"/>
                                    <DataGridTextColumn Header="Ngày chốt" Binding="{Binding NgayKetThucFormatted}" Width="100"/>
                                    <DataGridTextColumn Header="Tiền vốn" Binding="{Binding TienNhapFormatted}" Width="110"/>
                                    <DataGridTextColumn Header="Số áo đã bán" Binding="{Binding TongSoAoBanLe, StringFormat='{}{0} cái'}" Width="100"/>
                                    <DataGridTextColumn Header="Thu bán lẻ" Binding="{Binding TongTienBanLeFormatted}" Width="120"/>
                                    <DataGridTextColumn Header="Thu bao thừa" Binding="{Binding TienBanThuaFormatted}" Width="120"/>
                                    <DataGridTextColumn Header="Tổng thu" Binding="{Binding TongThuFormatted}" Width="110"/>
                                    <DataGridTextColumn Header="LÃI HƠN VỐN" Binding="{Binding LoiNhuanFormatted}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{Binding LoiNhuan, Converter={StaticResource ProfitColorConverter}}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="% Lãi/Lỗ" Binding="{Binding TyLeLoiNhuanFormatted}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{Binding LoiNhuan, Converter={StaticResource ProfitColorConverter}}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="95"/>
                                    <DataGridTemplateColumn Header="Thao tác" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Xóa" FontSize="11" FontWeight="SemiBold" Padding="8,3"
                                                        Command="{Binding DataContext.XoaBaoHangCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FEE2E2" Foreground="#B91C1C" Style="{StaticResource ModernButton}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
