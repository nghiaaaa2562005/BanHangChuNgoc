<Window x:Class="BanHangChuNgoc.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Bán Hàng Chú Ngọc"
        Height="440" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI, Helvetica, Arial">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Hộp thẻ đăng nhập -->
        <Border Width="360" Background="White" CornerRadius="12" Padding="28,32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Tiêu đề -->
                <TextBlock Text="BÁN HÀNG CHÚ NGỌC" 
                           FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Quản lý bao hàng &amp; dòng tiền" 
                           FontSize="13" Foreground="#64748B" 
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Nhập Tài khoản -->
                <TextBlock Text="Tài khoản:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="txtTaiKhoan" Style="{StaticResource ModernTextBox}" Height="38" 
                         FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,16"
                         KeyDown="TxtTaiKhoan_KeyDown"/>

                <!-- Nhập Mật khẩu -->
                <TextBlock Text="Mật khẩu:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtMatKhau" Height="38" FontSize="14" VerticalContentAlignment="Center" 
                             Padding="8,6" Margin="0,0,0,12"
                             KeyDown="TxtMatKhau_KeyDown"/>

                <!-- Thông báo lỗi (nếu nhập sai) -->
                <Border x:Name="borderLoi" Background="#FEE2E2" CornerRadius="6" Padding="10,6" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="lblThongBaoLoi" Text="Sai tài khoản hoặc mật khẩu!" 
                               Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Nút Đăng nhập -->
                <Button x:Name="btnDangNhap" Style="{StaticResource ModernButton}" 
                        Content="ĐĂNG NHẬP" Height="42"
                        Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold"
                        Click="BtnDangNhap_Click" IsDefault="True" Margin="0,0,0,10"/>

                <!-- Nút Thoát -->
                <Button x:Name="btnThoat" Style="{StaticResource ModernButton}" 
                        Content="Thoát ứng dụng" Height="36"
                        Background="#F1F5F9" Foreground="#64748B" FontSize="13" FontWeight="Normal"
                        Click="BtnThoat_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
